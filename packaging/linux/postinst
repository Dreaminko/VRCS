#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
  if [ -d /usr/lib/vrcs ]; then
    chown root:root /usr/lib/vrcs
    chmod 0755 /usr/lib/vrcs
  fi
  if [ -f /usr/lib/vrcs/vrcs-network-helper ]; then
    chown root:root /usr/lib/vrcs/vrcs-network-helper
    chmod 0755 /usr/lib/vrcs/vrcs-network-helper
  fi
fi
