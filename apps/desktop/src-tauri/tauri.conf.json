{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VRCS",
  "version": "0.1.9",
  "identifier": "app.vrcs.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VRCS",
        "width": 1180,
        "height": 760,
        "minWidth": 860,
        "minHeight": 620,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src http://127.0.0.1:* ws://127.0.0.1:*; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false
  }
}
