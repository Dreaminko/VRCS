{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "app.vrcs.desktop",
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/qwen-runtime/": "qwen-runtime/",
      "resources/vulkan-runtime/vulkan-1.dll": "vulkan-1.dll",
      "resources/vulkan-runtime/VulkanRT-License.txt": "VulkanRT-License.txt",
      "../../../LICENSE": "LICENSE",
      "../../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": false,
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
