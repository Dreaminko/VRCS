{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop capability",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-set-min-size",
    "core:window:allow-set-size",
    "core:window:allow-set-size-constraints",
    "core:window:allow-set-resizable",
    "core:window:allow-set-shadow",
    "core:webview:allow-set-webview-zoom",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-confirm",
    "dialog:allow-message",
    "store:default",
    "allow-core-connection",
    "allow-core-startup",
    "allow-retry-core",
    "allow-player-audio-pending-action",
    "allow-player-audio-consume-action",
    "allow-player-audio-ensure-privileges",
    "allow-player-audio-memory-status",
    "allow-player-audio-set-memory-compression",
    "allow-write-glossary-file",
    "allow-open-vrcx-repository",
    "allow-diagnostic-status",
    "allow-report-frontend-error",
    "allow-open-log-directory",
    "allow-export-error-report",
    "allow-app-build-info",
    "allow-check-for-update",
    "allow-download-and-install-update",
    "allow-update-native-labels",
    "allow-set-compact-window-topmost",
    "allow-vr-overlay-status",
    "allow-vr-overlay-retry",
    "allow-vr-ocr-open-bindings",
    "allow-vr-overlay-show-sample",
    "allow-vr-overlay-hide-sample",
    "allow-vr-dashboard-update-view",
    "allow-vr-overlay-control-ready",
    "allow-vr-overlay-control-update",
    "allow-vr-overlay-player-audio-update",
    "allow-vr-overlay-control-result",
    "allow-vr-overlay-control-release",
    "allow-vr-overlay-placement-result",
    "allow-vr-overlay-place-dialogue",
    "allow-set-shortcut-recording",
    "allow-desktop-ocr-status",
    "allow-desktop-ocr-scan",
    "allow-desktop-ocr-close",
    "allow-desktop-vision-status",
    "allow-desktop-vision-open",
    "allow-desktop-vision-capture",
    "allow-desktop-vision-image",
    "allow-desktop-vision-start-recording",
    "allow-desktop-vision-finish-recording",
    "allow-desktop-vision-ask",
    "allow-desktop-vision-cancel",
    "allow-desktop-vision-close"
  ]
}
