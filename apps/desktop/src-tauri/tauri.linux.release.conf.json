{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "category": "Utility",
    "targets": ["deb", "rpm", "appimage"],
    "createUpdaterArtifacts": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "resources": {
      "../../../LICENSE": "LICENSE",
      "../../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "linux": {
      "deb": { "recommends": ["fonts-noto-cjk", "libopenxr-loader1", "xdg-utils", "xdg-desktop-portal"] },
      "rpm": {
        "compression": { "type": "zstd", "level": 3 },
        "recommends": [
          "(libayatana-appindicator3.so.1()(64bit) or libappindicator3.so.1()(64bit))",
          "libopenxr_loader.so.1()(64bit)",
          "xdg-utils",
          "xdg-desktop-portal"
        ]
      },
      "appimage": { "bundleMediaFramework": false }
    }
  }
}
