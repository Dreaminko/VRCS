{
  "name": "@vrcs/desktop",
  "private": true,
  "version": "0.2.2",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prepare:qwen": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/prepare-qwen-runtime.ps1",
    "prepare:vulkan": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/prepare-vulkan-runtime.ps1",
    "build": "tsc && vite build",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "test": "npm run typecheck:tests && node --test tests/*.test.ts",
    "tauri": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/run-tauri.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-store": "^2.4.4",
    "i18next": "^26.3.6",
    "lucide-react": "^1.25.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.11"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
